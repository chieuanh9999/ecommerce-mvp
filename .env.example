
# PostgreSQL configuration
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# Database URL for Node.js running locally
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ecommerce_mvp?schema=public"

# Express Server
PORT=3001

# JWT Authentication
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d
